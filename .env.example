# Generate the two keys using the commands in README.md. Keep this file outside Git.
APP_SECRET_KEY=replace_with_random_value
ENCRYPTION_KEY=replace_with_fernet_key
DATABASE_PATH=data/bring_loader.sqlite3
COOKIE_SECURE=0
# Docker Compose publishes to this host address only. Change to your LAN IP for phone access.
HOST_BIND=127.0.0.1
APP_PORT=8723
